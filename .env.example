# LiMeiHua Taproot Airdrop Zone - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Lightning Network Configuration
LIGHTNING_NODE_URL=https://api.lightning.engineering
LIGHTNING_API_KEY=your_lightning_api_key_here

# Bitcoin Configuration
BITCOIN_RPC_URL=https://btc-rpc.example.com
BITCOIN_NETWORK=mainnet

# Taproot Assets Configuration
TAPROOT_API_URL=https://api.taproot.example.com
TAPROOT_API_KEY=your_taproot_api_key_here

# Database Configuration (if using real database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=limeihua_airdrop
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Admin Configuration
ADMIN_EMAIL=admin@limeihua.com
ADMIN_PASSWORD=admin123

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_TESTNET=true
ENABLE_SANDBOX=true
ENABLE_DEBUG=false

# Airdrop Configuration
MIN_AIRDROP_AMOUNT=0.0001
MAX_AIRDROP_AMOUNT=100
BATCH_SIZE=100
CLAIM_TIMEOUT=3600

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
